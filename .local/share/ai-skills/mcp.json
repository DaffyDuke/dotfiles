{
  "servers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {
        "redirectUri": "http://127.0.0.1:19876/mcp/oauth/callback"
      }
    },
    "cloud-cost": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "cloud-cost-mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "datadog": {
      "type": "http",
      "url": "https://mcp.datadoghq.eu/v1/mcp",
      "oauth": {
        "redirectUri": "http://127.0.0.1:43773/callback"
      }
    },
    "forgejo": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@rubicontv/forgejo-mcp"
      ],
      "env": {
        "FORGEJO_BASE_URL": "https://git.lautre.net",
        "FORGEJO_TOKEN": "${FORGEJO_TOKEN}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "google-workspace": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "workspace-mcp",
        "--tools",
        "drive",
        "chat"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      }
    },
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-kubernetes"
      ]
    },
    "terraform": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "terraform-mcp-server",
        "stdio"
      ],
      "env": {
        "TF_TOKEN_app_terraform_io": "${TF_TOKEN_app_terraform_io}"
      }
    }
  }
}

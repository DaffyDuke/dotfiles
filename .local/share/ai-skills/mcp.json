{
  "servers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/sse"
    },
    "cloud-cost": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "cloud-cost-mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "datadog": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "datadog-mcp"
      ],
      "env": {
        "DD_API_KEY": "${DD_API_KEY}",
        "DD_APP_KEY": "${DD_APP_KEY}",
        "DD_SITE": "datadoghq.eu"
      }
    },
    "forgejo": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@rubicontv/forgejo-mcp"
      ],
      "env": {
        "FORGEJO_BASE_URL": "https://git.lautre.net",
        "FORGEJO_TOKEN": "${FORGEJO_TOKEN}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "google-workspace": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "workspace-mcp",
        "--tools",
        "drive",
        "chat"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      }
    },
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-kubernetes"
      ]
    },
    "terraform": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "terraform-mcp-server",
        "stdio"
      ],
      "env": {
        "TF_TOKEN_app_terraform_io": "${TF_TOKEN_app_terraform_io}"
      }
    }
  }
}
